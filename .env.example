DATABASE_URL=postgresql://postgres@localhost:5432/360nfc_valet
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@wewant360.com
ADMIN_PASSWORD=admin123

# SMTP (optional). When unset, the forgot-password API returns the reset link
# directly (demo mode) instead of emailing it.
# SMTP_HOST=smtp.example.com
# SMTP_USER=...
# SMTP_PASS=...

# SSO / OIDC (optional). When SSO_AUTHORIZE_URL and SSO_CLIENT_ID are unset,
# "Sign in with SSO" falls back to a demo sign-in as the first admin.
# SSO_AUTHORIZE_URL=https://idp.example.com/oauth2/authorize
# SSO_TOKEN_URL=https://idp.example.com/oauth2/token
# SSO_JWKS_URL=https://idp.example.com/oauth2/jwks
# SSO_CLIENT_ID=your-client-id
# SSO_CLIENT_SECRET=your-client-secret
# SSO_ISSUER=https://idp.example.com
# SSO_CALLBACK_URL=http://localhost:3000/api/auth/sso/callback
